<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="match_parent"
    android:orientation="horizontal"
    android:layout_height="@dimen/settingslib_toolbar_layout_height"
    android:paddingRight="6dp"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <ImageView
        android:id="@+id/imgLeft"
        android:layout_alignParentLeft="true"
        android:layout_width="wrap_content"
        android:src="@drawable/icon_left"
        android:layout_centerVertical="true"
        android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/imgRight"
        android:layout_toRightOf="@id/imgLeft"
        android:layout_width="wrap_content"
        android:src="@drawable/icon_right"
        android:visibility="gone"
        android:layout_centerVertical="true"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtMenuTitle"
        android:layout_toRightOf="@id/imgRight"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_centerVertical="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>


    <ImageView
        android:id="@+id/imgFullscreen"
        android:layout_gravity="center_vertical|end"
        android:src="@drawable/window_full_screen_button"
        android:duplicateParentState="true"
        android:layout_height="@dimen/top_menu_icon_size"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@id/imgMinimize"
        android:padding="@dimen/top_menu_icon_padding"
        android:layout_width="@dimen/top_menu_icon_size"/>

    <ImageView
        android:id="@+id/imgMinimize"
        android:layout_gravity="center_vertical|end"
        android:src="@drawable/window_mini_button"
        android:duplicateParentState="true"
        android:layout_height="@dimen/top_menu_icon_size"
        android:layout_toLeftOf="@id/imgMaximize"
        android:layout_centerVertical="true"
        android:padding="@dimen/top_menu_icon_padding"
        android:layout_width="@dimen/top_menu_icon_size"/>

    <ImageView
        android:id="@+id/imgMaximize"
        android:layout_gravity="center_vertical|end"
        android:src="@drawable/window_normal_button"
        android:duplicateParentState="true"
        android:layout_height="@dimen/top_menu_icon_size"
        android:layout_toLeftOf="@id/imgClose"
        android:layout_centerVertical="true"
        android:padding="@dimen/top_menu_icon_padding"
        android:layout_width="@dimen/top_menu_icon_size"/>

    <ImageView
        android:id="@+id/imgClose"
        android:src="@drawable/window_close_button"
        android:duplicateParentState="true"
        android:layout_height="@dimen/top_menu_icon_size"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:padding="@dimen/top_menu_icon_padding"
        android:layout_width="@dimen/top_menu_icon_size"/>

</RelativeLayout>